generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  ACCOUNTANT
  CONTACT
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

enum AccountType {
  ASSET
  LIABILITY
  EXPENSE
  INCOME
  CAPITAL
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
  GENERAL
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum AnalyticType {
  INCOME
  EXPENSE
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
}

enum PaymentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

// ============================================================
// USER
// ============================================================

model User {
  id           String   @id @default(cuid())
  loginId String @unique
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CONTACT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdSalesOrders    SalesOrder[]    @relation("SalesOrderCreatedBy")
  createdSalesInvoices  SalesInvoice[]  @relation("SalesInvoiceCreatedBy")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  createdVendorBills    VendorBill[]    @relation("VendorBillCreatedBy")
  createdPayments       Payment[]       @relation("PaymentCreatedBy")
  createdJournalEntries JournalEntry[]  @relation("JournalEntryCreatedBy")
  stockMovements        StockMovement[] @relation("StockMovementCreatedBy")
}

// ============================================================
// CONTACT
// ============================================================

model Contact {
  id   String      @id @default(cuid())
  name String
  type ContactType

  email  String?
  mobile String?

  address String?
  city    String?
  state   String?
  pincode String?

  profileImage String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrders    SalesOrder[]
  salesInvoices  SalesInvoice[]
  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]

  customerPayments Payment[] @relation("CustomerPayments")
  vendorPayments   Payment[] @relation("VendorPayments")

  @@index([name])
  @@index([type])
  @@index([isActive])
}

// ============================================================
// PRODUCT CATEGORY
// ============================================================

model ProductCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id          String      @id @default(cuid())
  sku         String      @unique
  name        String
  description String?
  type        ProductType

  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  salesPrice    Decimal @db.Decimal(12, 2)
  purchasePrice Decimal @db.Decimal(12, 2)

  stockQuantity Decimal @default(0) @db.Decimal(12, 2)
  reorderLevel  Decimal @default(0) @db.Decimal(12, 2)

  taxRate Decimal @default(0) @db.Decimal(5, 2)

  imageUrl String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@index([name])
  @@index([categoryId])
  @@index([type])
  @@index([isActive])
}

// ============================================================
// ACCOUNT
// ============================================================

model Account {
  id   String      @id @default(cuid())
  code String      @unique
  name String
  type AccountType

  openingBalance Decimal @default(0) @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalItems JournalItem[]

  debitJournals  Journal[] @relation("DefaultDebitAccount")
  creditJournals Journal[] @relation("DefaultCreditAccount")

  @@index([type])
  @@index([isActive])
}

// ============================================================
// JOURNAL
// ============================================================

model Journal {
  id   String      @id @default(cuid())
  code String      @unique
  name String
  type JournalType

  defaultDebitAccountId  String?
  defaultCreditAccountId String?

  defaultDebitAccount  Account? @relation("DefaultDebitAccount", fields: [defaultDebitAccountId], references: [id], onDelete: SetNull)
  defaultCreditAccount Account? @relation("DefaultCreditAccount", fields: [defaultCreditAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries JournalEntry[]

  @@index([type])
}

// ============================================================
// ANALYTIC ACCOUNT
// ============================================================

model AnalyticAccount {
  id   String       @id @default(cuid())
  name String
  type AnalyticType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  budgets      Budget[]
  journalItems JournalItem[]
}

// ============================================================
// BUDGET
// ============================================================

model Budget {
  id   String @id @default(cuid())
  name String

  periodStart DateTime
  periodEnd   DateTime

  amount Decimal @db.Decimal(12, 2)

  responsiblePerson String?

  analyticAccountId String
  analyticAccount   AnalyticAccount @relation(fields: [analyticAccountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analyticAccountId])
  @@index([periodStart, periodEnd])
}

// ============================================================
// JOURNAL ENTRY
// ============================================================

model JournalEntry {
  id String @id @default(cuid())

  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Restrict)

  date        DateTime
  reference   String?
  description String?

  status JournalEntryStatus @default(DRAFT)

  createdById String?
  createdBy   User?   @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items JournalItem[]

  @@index([journalId])
  @@index([date])
  @@index([status])
}

// ============================================================
// JOURNAL ITEM
// ============================================================

model JournalItem {
  id String @id @default(cuid())

  journalEntryId String
  accountId      String

  debit  Decimal @default(0) @db.Decimal(12, 2)
  credit Decimal @default(0) @db.Decimal(12, 2)

  analyticAccountId String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  analyticAccount AnalyticAccount? @relation(fields: [analyticAccountId], references: [id], onDelete: SetNull)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([analyticAccountId])
}

// ============================================================
// SALES ORDER
// ============================================================

model SalesOrder {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerId String
  customer   Contact @relation(fields: [customerId], references: [id], onDelete: Restrict)

  orderDate DateTime

  status DocumentStatus @default(DRAFT)

  subtotal Decimal @db.Decimal(12, 2)
  tax      Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  notes String?

  createdById String?
  createdBy   User?   @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   SalesOrderItem[]
  invoice SalesInvoice?

  @@index([customerId])
  @@index([orderDate])
  @@index([status])
}

// ============================================================
// SALES ORDER ITEM
// ============================================================

model SalesOrderItem {
  id String @id @default(cuid())

  salesOrderId String
  productId    String

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  total     Decimal @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([productId])
}

// ============================================================
// SALES INVOICE
// ============================================================

model SalesInvoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique

  salesOrderId String @unique
  customerId   String

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  customer   Contact    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  invoiceDate DateTime
  dueDate     DateTime?

  subtotal Decimal @db.Decimal(12, 2)
  tax      Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  status DocumentStatus @default(DRAFT)

  notes String?

  createdById String?
  createdBy   User?   @relation("SalesInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentAllocations PaymentAllocation[]

  @@index([customerId])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([status])
}

// ============================================================
// PURCHASE ORDER
// ============================================================

model PurchaseOrder {
  id          String @id @default(cuid())
  orderNumber String @unique

  vendorId String
  vendor   Contact @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  orderDate DateTime

  status DocumentStatus @default(DRAFT)

  subtotal Decimal @db.Decimal(12, 2)
  tax      Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  notes String?

  createdById String?
  createdBy   User?   @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseOrderItem[]
  bill  VendorBill?

  @@index([vendorId])
  @@index([orderDate])
  @@index([status])
}

// ============================================================
// PURCHASE ORDER ITEM
// ============================================================

model PurchaseOrderItem {
  id String @id @default(cuid())

  purchaseOrderId String
  productId       String

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  total     Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
}

// ============================================================
// VENDOR BILL
// ============================================================

model VendorBill {
  id         String @id @default(cuid())
  billNumber String @unique

  purchaseOrderId String @unique
  vendorId        String

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  vendor        Contact       @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  invoiceDate DateTime
  dueDate     DateTime?

  subtotal Decimal @db.Decimal(12, 2)
  tax      Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  status DocumentStatus @default(DRAFT)

  notes String?

  createdById String?
  createdBy   User?   @relation("VendorBillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentAllocations PaymentAllocation[]

  @@index([vendorId])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([status])
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id            String @id @default(cuid())
  paymentNumber String @unique

  amount Decimal @db.Decimal(12, 2)

  paymentDate DateTime
  method      PaymentMethod
  status      PaymentStatus @default(DRAFT)

  reference String?
  notes     String?

  customerId String?
  vendorId   String?

  customer Contact? @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: SetNull)
  vendor   Contact? @relation("VendorPayments", fields: [vendorId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([vendorId])
  @@index([paymentDate])
  @@index([status])
}

// ============================================================
// PAYMENT ALLOCATION
// ============================================================

model PaymentAllocation {
  id String @id @default(cuid())

  paymentId String
  amount    Decimal @db.Decimal(12, 2)

  salesInvoiceId String?
  vendorBillId   String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  vendorBill   VendorBill?   @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([salesInvoiceId])
  @@index([vendorBillId])
}

// ============================================================
// STOCK MOVEMENT
// ============================================================

model StockMovement {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  type     StockMovementType
  quantity Decimal           @db.Decimal(12, 2)

  reference String?
  notes     String?

  date DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([type])
  @@index([date])
}